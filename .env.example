# ここには「名前だけ」を置く。値は Vercel / ローカルの .env.local に入れる（仕様 5章: 秘密値をコードへ書かない）
# 1つも設定しなければデモモード（インメモリ）で動く。

# 初期データの種類: empty（既定・架空の子どもなし） | sample（画面確認用の架空データ）
IPPO_SEED=

# --- Supabase（本番） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。NEXT_PUBLIC_ を絶対に付けない
SUPABASE_SERVICE_ROLE_KEY=

# --- Mux Signed Playback（サーバー専用） ---
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# --- セッション（デモモードでも本番でも使う。未設定のデモでは起動ごとにランダム生成） ---
IPPO_SESSION_SECRET=
